# FinSight AI Gateway — ECS production environment (P0-5B1A)
# Copy to /etc/finsight-ai-gateway/production.env on the ECS instance.
# Fill secrets manually on the server. Never commit real values to git.

YOUSHU_ENV=production
# Set automatically by install-on-ecs.sh on each deploy (do not leave CHANGE_ME).
BUILD_VERSION=

# Bind localhost only until ICP completes and Nginx terminates HTTPS publicly.
BIND_ADDR=127.0.0.1
PORT=8080

SCHEMA_VERSION=v1
MODEL_ALIAS=qwen3.7-plus

UPSTREAM_AI_PROVIDER=bailian
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_TIMEOUT_SECONDS=25
BAILIAN_STRUCTURED_OUTPUT_MODE=json_object

GATEWAY_CLIENT_TOKEN=

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BASE_DELAY_MS=500
UPSTREAM_RETRY_MAX_DELAY_MS=8000
UPSTREAM_MAX_CONCURRENCY=4

HTTP_READ_HEADER_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_WRITE_TIMEOUT_SECONDS=60
HTTP_IDLE_TIMEOUT_SECONDS=120
SHUTDOWN_TIMEOUT_SECONDS=30

# Forbidden in production — leave unset
# YOUSHU_SMOKE_DUMP_RAW=1
