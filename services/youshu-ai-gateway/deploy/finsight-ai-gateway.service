[Unit]
Description=FinSight AI Gateway
Documentation=file:/opt/finsight-ai-gateway/README-deploy.txt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=finsight
Group=finsight
WorkingDirectory=/opt/finsight-ai-gateway
EnvironmentFile=-/etc/finsight-ai-gateway/production.env
ExecStart=/opt/finsight-ai-gateway/current/finsight-ai-gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
