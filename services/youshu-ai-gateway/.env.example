# FinSight AI Gateway — local / staging configuration (do not commit real secrets)

# development | test | production
YOUSHU_ENV=development

PORT=8080
# ECS internal deployment (ICP pending): bind localhost only. Empty = all interfaces.
# BIND_ADDR=127.0.0.1
SCHEMA_VERSION=v1
MODEL_ALIAS=mock-qwen
BUILD_VERSION=dev

# Upstream AI: mock (development/test default) | bailian (required in production)
UPSTREAM_AI_PROVIDER=mock

# Bailian / Alibaba Cloud Model Studio (required when UPSTREAM_AI_PROVIDER=bailian)
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
BAILIAN_MODEL=qwen-plus
BAILIAN_TIMEOUT_SECONDS=25
# json_object (default / production) or json_schema_strict (P0-4.3D experiment)
BAILIAN_STRUCTURED_OUTPUT_MODE=json_object

# Optional in development; required in production
GATEWAY_CLIENT_TOKEN=

# Inbound rate limit (fixed window)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Upstream reliability
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BASE_DELAY_MS=500
UPSTREAM_RETRY_MAX_DELAY_MS=8000
UPSTREAM_MAX_CONCURRENCY=4

# HTTP server timeouts (seconds)
HTTP_READ_HEADER_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_WRITE_TIMEOUT_SECONDS=60
HTTP_IDLE_TIMEOUT_SECONDS=120
SHUTDOWN_TIMEOUT_SECONDS=30

# Debug only — forbidden when YOUSHU_ENV=production
# YOUSHU_SMOKE_DUMP_RAW=1
