{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "body",
    "answer",
    "citedFactKeys",
    "confidence",
    "keyFacts",
    "references",
    "riskExplanations",
    "unknownExplanations"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "answer": { "type": "string", "minLength": 1 },
    "citedFactKeys": {
      "type": "array",
      "items": { "type": "string" }
    },
    "disclaimer": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "keyFacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/keyFact" }
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    },
    "riskExplanations": {
      "type": "array",
      "items": { "$ref": "#/$defs/riskExplanation" }
    },
    "unknownExplanations": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknownExplanation" }
    }
  },
  "$defs": {
    "keyFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "kind", "source"],
      "properties": {
        "label": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["balance", "income", "expense", "debt", "cashFlow", "savings", "purchase", "other"]
        },
        "source": { "type": "string" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string" }
      }
    },
    "riskExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "text"],
      "properties": {
        "reasonCode": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "unknownExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "text"],
      "properties": {
        "reasonCode": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
