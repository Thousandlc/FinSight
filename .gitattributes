# Deployment line endings and encoding for Unix/ECS artifacts.

*.sh          text eol=lf
*.service     text eol=lf
*.template    text eol=lf
*.conf        text eol=lf
deploy/**     text eol=lf

*.ps1         text eol=crlf

*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
*.woff        binary
*.woff2       binary
